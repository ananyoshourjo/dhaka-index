# Official CC0 job snapshot published by the private Dhaka Index crawler.
DHAKA_INDEX_JOB_FEED_URL=https://raw.githubusercontent.com/ananyoshourjo/dhaka-index/jobs-data/jobs.json
NEXT_TELEMETRY_DISABLED=1

# Public origins for each local application.
BETTER_AUTH_URL=http://127.0.0.1:3000
ADMIN_AUTH_URL=http://127.0.0.1:3010
ADMIN_PORTAL_URL=http://127.0.0.1:3010

# Optional for deployments. If omitted, one strong shared secret is generated
# locally under data/auth-secret and used by both applications.
# BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Optional comma-separated origins for reverse-proxy/self-hosted deployments.
# DHAKA_INDEX_TRUSTED_ORIGINS=https://jobs.example.com,https://admin.example.com

# Optional absolute directory for the local SQLite database and secrets.
# DHAKA_INDEX_DATA_DIR=/var/lib/dhaka-index
