# Official CC0 job snapshot published by the private Dhaka Index crawler.
DHAKA_INDEX_JOB_FEED_URL=https://raw.githubusercontent.com/ananyoshourjo/dhaka-index/jobs-data/jobs.json
NEXT_TELEMETRY_DISABLED=1

# Optional public Cloudflare Web Analytics site token. Set this as a build
# variable for the member app, or place it in `.env.local` for local builds.
# Use either this manual beacon or Cloudflare's automatic setup, not both.
# NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=replace-with-your-site-token

# Optional privacy-safe PostHog product analytics for the member app. Both
# values are required. The app sends only the documented manual events and
# opaque Better Auth user ID; autocapture, replay, heatmaps, and surveys stay off.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=replace-with-your-project-token
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public origins for each Cloudflare Worker.
BETTER_AUTH_URL=https://dhaka-index.example.workers.dev
ADMIN_AUTH_URL=https://dhaka-index-admin.example.workers.dev
ADMIN_PORTAL_URL=https://dhaka-index-admin.example.workers.dev

# Required deployment secret. Store the same strong value on both Workers with
# `wrangler secret put BETTER_AUTH_SECRET`; do not commit it to this file.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Required only on the member Worker. It authenticates the internal Cron
# request that refreshes the job feed without a signed-in visitor.
JOB_SYNC_SECRET=replace-with-a-different-strong-random-value

# Optional comma-separated additional trusted origins.
# DHAKA_INDEX_TRUSTED_ORIGINS=https://jobs.example.com,https://admin.example.com

# Optional local inputs for `npm run health:hosted`. Prefer a dedicated
# synthetic-check member account. Never commit real credentials or cookies.
# DHAKA_INDEX_HEALTH_BASE_URL=https://dhaka-index.example.workers.dev
# DHAKA_INDEX_HEALTH_EMAIL=synthetic-check@example.com
# DHAKA_INDEX_HEALTH_PASSWORD=replace-with-the-synthetic-account-password
# DHAKA_INDEX_HEALTH_REQUESTS=20
